{
  "name": "jl-grammar",
  "version": "0.1.0",
  "description": "A Chevrotain-like parsing toolkit whose grammars are JSON Logic, executed by json-logic-engine.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "import": "./dist/esm/runtime.js",
      "require": "./dist/cjs/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build && npm test && npm run test:csp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:csp": "node --disallow-code-generation-from-strings scripts/check-no-eval.mjs",
    "generate": "node bin/jl-grammar.js generate",
    "bench": "node bench/bench.js",
    "bench:compare": "node bench/compare-codex.js",
    "bench:formula": "node bench/peggy/build.js && node bench/formula.js",
    "bench:generated": "node bench/peggy/build.js && node bench/generate-formula.js && node bench/generated.js"
  },
  "keywords": [
    "json-logic",
    "parser",
    "grammar",
    "chevrotain",
    "peg"
  ],
  "license": "MIT",
  "dependencies": {
    "json-logic-engine": "^5.0.7"
  },
  "devDependencies": {
    "chevrotain": "^13.2.0",
    "esbuild": "^0.28.2",
    "peggy": "^5.1.0",
    "vitest": "^3.2.4"
  },
  "bin": {
    "jl-grammar": "./bin/jl-grammar.js"
  }
}
