// Complete JSON grammar, self-contained: the actions below decode literals and
// build JSON values, and the JavaScript they call travels with them in the
// `methods` block at the end.
//
// This is the sandbox's copy. `examples/json.gram` is the same grammar with its
// methods supplied by `examples/json.js`, which is what keeps that pair usable
// under a Content-Security-Policy — evaluating a methods block needs `eval`.

grammar JSON;
start value;

token WS pattern "[ \\t\\r\\n]+" skip;
token String pattern "\"(?:[^\"\\\\\\u0000-\\u001f]|\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"";
token Number pattern "-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?";
token True literal "true";
token False literal "false";
token Null literal "null";
token LCurly literal "{";
token RCurly literal "}";
token LSquare literal "[";
token RSquare literal "]";
token Comma literal ",";
token Colon literal ":";

rule value = alt(
  subrule(object),
  subrule(array),
  seq(
    label(s, consume(String)),
    action({"unquote":{"val":["s","image"]}})
  ),
  seq(
    label(n, consume(Number)),
    action({"num":{"val":["n","image"]}})
  ),
  seq(consume(True), action(true)),
  seq(consume(False), action(false)),
  seq(consume(Null), action(null))
);

rule object = seq(
  consume(LCurly),
  label(pairs, manySep(subrule(pair), Comma)),
  consume(RCurly),
  action({"fromPairs":{"val":"pairs"}})
);

rule pair = seq(
  label(k, consume(String)),
  consume(Colon),
  label(v, subrule(value)),
  action([{"unquote":{"val":["k","image"]}},{"val":"v"}])
);

rule array = seq(
  consume(LSquare),
  label(items, manySep(subrule(value), Comma)),
  consume(RSquare),
  action({"val":"items"})
);

methods {
  export const unquote = { method: (image) => JSON.parse(image), optimizeUnary: true }
  export const num = { method: (image) => +image, optimizeUnary: true }
  export const fromPairs = {
    method: (pairs) => {
      const out = {}
      for (let i = 0; i < pairs.length; i++) out[pairs[i][0]] = pairs[i][1]
      return out
    },
    optimizeUnary: true
  }
}
